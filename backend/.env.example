PORT=8080
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# Firebase Admin (matching earn-share-admin-panel .env format)
STORE_MODE=memory # change to 'firestore' when credentials are provided
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# or path if using serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=

# Admin Authentication
ADMIN_EMAIL=admin@iggrow.studio
ADMIN_PASSWORD=admin123456
ADMIN_JWT_SECRET=super-secret-admin-jwt-key-change-in-prod

# Local dev / testing flags
DEV_BYPASS_AUTH=true
